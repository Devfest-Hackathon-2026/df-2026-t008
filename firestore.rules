rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /pleaseUsers/{uid}/progress/{language} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid
        && language in ['javascript', 'python']
        && request.resource.data.keys().hasOnly(['version','stageIndex','solved','drafts','completed','updatedAt'])
        && ((('version' in request.resource.data) && request.resource.data.version == 2)
          || ((! ('version' in request.resource.data) || request.resource.data.version == 1)
            && request.resource.data.stageIndex <= 3))
        && request.resource.data.stageIndex is int
        && request.resource.data.stageIndex >= 0 && request.resource.data.stageIndex <= 53
        && request.resource.data.solved is list && request.resource.data.solved.size() <= 1000
        && request.resource.data.drafts is map
        && request.resource.data.completed is bool
        && request.resource.data.updatedAt is number;
    }
  }
}
