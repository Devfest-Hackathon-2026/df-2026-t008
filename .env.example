# Optional: without these, local guest solo + WebSocket cooperation work.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Optional Google-hosted cooperation (requires auth + database.rules.json).
VITE_FIREBASE_DATABASE_URL=
# Optional Gemini hints through Node/Cloud Run API. Never use VITE_ for the key.
VITE_ENABLE_AI=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Optional separate hint API origin for Firebase Hosting + Cloud Run.
VITE_API_URL=

# For a separate Cloud Run hint API, allow the exact Firebase Hosting origin.
ALLOWED_ORIGIN=
